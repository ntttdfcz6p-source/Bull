<section class="bf-section bf-text-center" style="background:var(--bf-action-red);color:var(--bf-white);">
  <div class="bf-container">
    <h2>{{ section.settings.heading }}</h2>
    <a href="#bf-purchase" class="bf-btn bf-btn--outline-dark">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "DR Final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FUEL YOUR POWER." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Get BullRush" }
  ],
  "presets": [{ "name": "DR Final CTA" }]
}
{% endschema %}
