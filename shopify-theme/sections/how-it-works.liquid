{% comment %}
  Milestone timeline — visual pattern (connecting line + pill milestones)
  adapted from the competitor reference at the user's request (see
  strategy/01-brand-application-guide.md §7). The reference's version makes
  specific physiological claims per milestone (e.g. "T-production optimized
  fully") with no substantiation shown — this version deliberately limits
  itself to routine/habit-building language (which needs no clinical
  substantiation) and marks any subjective-effect bullet as an explicit
  placeholder pending real customer survey data, per
  strategy/08-review-ugc-plan.md.
{% endcomment %}
<section class="bf-section bf-bg-white">
  <div class="bf-container" style="max-width:640px;">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="bf-muted" style="margin-bottom:32px;">{{ section.settings.subheading }}</p>

    <div class="bf-timeline bf-reveal">
      {%- for block in section.blocks -%}
        <div class="bf-milestone">
          <div class="bf-milestone__head">
            <span class="bf-milestone__pill">{{ block.settings.pill }}</span>
            <span class="bf-milestone__name">{{ block.settings.name }}</span>
          </div>
          <ul>
            {%- if block.settings.point_1 != blank -%}<li>{{ block.settings.point_1 }}</li>{%- endif -%}
            {%- if block.settings.point_2 != blank -%}<li>{{ block.settings.point_2 }}</li>{%- endif -%}
            {%- if block.settings.point_3 != blank -%}<li>{{ block.settings.point_3 }}</li>{%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for consistency, not a quick fix" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A daily routine, not a one-off try — here's what to expect as you build the habit." }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "pill", "label": "Pill label (e.g. Week 1)" },
        { "type": "text", "id": "name", "label": "Milestone name" },
        { "type": "text", "id": "point_1", "label": "Point 1" },
        { "type": "text", "id": "point_2", "label": "Point 2" },
        { "type": "text", "id": "point_3", "label": "Point 3" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "milestone",
        "settings": {
          "pill": "Week 1",
          "name": "Getting Started",
          "point_1": "Take your daily serving — [PLACEHOLDER: exact instructions pending final label]",
          "point_2": "Start building the habit into your existing routine",
          "point_3": "[PLACEHOLDER — subjective early-effect claim pending real customer survey data]"
        }
      },
      {
        "type": "milestone",
        "settings": {
          "pill": "Week 4",
          "name": "Building Consistency",
          "point_1": "Subscription keeps the routine uninterrupted",
          "point_2": "[PLACEHOLDER — subjective mid-point effect claim pending real customer survey data]"
        }
      },
      {
        "type": "milestone",
        "settings": {
          "pill": "Week 12",
          "name": "Full Routine",
          "point_1": "The daily habit is established",
          "point_2": "[PLACEHOLDER — subjective long-term effect claim pending real customer survey data]"
        }
      }
    ]
  },
  "presets": [{ "name": "How it works" }]
}
{% endschema %}
