{% comment %}
  Horizontal (desktop) / stacked (mobile) progression timeline. Limited to
  routine/habit-building language per the brief's own compliance rule ("do
  not promise specific physiological results") — every subjective-effect
  bullet ships marked [PLACEHOLDER] pending real customer survey data, per
  strategy/08-review-ugc-plan.md.
{% endcomment %}
<section class="bf-section bf-bg-black" style="position:relative;overflow:hidden;">
  <div class="bf-container">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="bf-muted" style="margin-bottom:32px;max-width:640px;">{{ section.settings.subheading }}</p>

    <div class="bf-timeline-h bf-reveal">
      {%- for block in section.blocks -%}
        <div class="bf-timeline-h__stage">
          <div class="bf-timeline-h__dot"></div>
          <span class="bf-timeline-h__pill">{{ block.settings.pill }}</span>
          <div class="bf-timeline-h__name">{{ block.settings.name }}</div>
          <p class="bf-timeline-h__body">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built For Consistency, Not A Quick Fix" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A daily routine, not a one-off try — here's what to expect as you build the habit." }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        { "type": "text", "id": "pill", "label": "Pill label (e.g. Day 1)" },
        { "type": "text", "id": "name", "label": "Stage name" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "stage", "settings": { "pill": "Day 1", "name": "Build The Habit", "body": "Take your daily serving — [PLACEHOLDER: exact instructions pending final label] — and fold it into your existing routine." } },
      { "type": "stage", "settings": { "pill": "Week 2", "name": "Feel The Momentum", "body": "[PLACEHOLDER — subjective early-effect claim pending real customer survey data]" } },
      { "type": "stage", "settings": { "pill": "Month 1", "name": "Perform Consistently", "body": "Subscription keeps the routine uninterrupted. [PLACEHOLDER — subjective claim pending real customer survey data]" } },
      { "type": "stage", "settings": { "pill": "Month 3", "name": "Own Your Routine", "body": "The daily habit is fully established. [PLACEHOLDER — subjective long-term claim pending real customer survey data]" } }
    ]
  },
  "presets": [{ "name": "How it works" }]
}
{% endschema %}
