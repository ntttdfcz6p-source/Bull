{% comment %} Condensed proof stack for cold traffic — ends on a repeated CTA. {% endcomment %}
<section class="bf-section bf-bg-graphite">
  <div class="bf-container">
    <span class="bf-eyebrow">Why It's Different</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="bf-grid-3 bf-mt-32" style="margin-bottom:32px;">
      {%- for block in section.blocks -%}
        <div class="bf-card">
          <h3>{{ block.settings.title }}</h3>
          <p class="bf-placeholder-note">{{ block.settings.status_text }}</p>
        </div>
      {%- endfor -%}
    </div>
    <div class="bf-text-center">
      <a href="#bf-purchase" class="bf-btn bf-btn--primary">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DR Proof stack",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Formula transparency, not hype" },
    { "type": "text", "id": "cta_label", "label": "Repeated CTA label", "default": "Choose Your Supply" }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "status_text", "label": "Status text" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "proof_item", "settings": { "title": "Manufacturing standard", "status_text": "[PLACEHOLDER — awaiting GMP facility certification]" } },
      { "type": "proof_item", "settings": { "title": "Third-party testing", "status_text": "[PLACEHOLDER — awaiting Certificate of Analysis]" } },
      { "type": "proof_item", "settings": { "title": "Real ingredients", "status_text": "Saffron, Panax ginseng, maca, vitamin B6 — no proprietary blend hiding amounts" } }
    ]
  },
  "presets": [{ "name": "DR Proof stack" }]
}
{% endschema %}
