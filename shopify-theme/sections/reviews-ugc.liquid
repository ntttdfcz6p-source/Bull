<section class="bf-section bf-bg-offwhite">
  <div class="bf-container">
    <span class="bf-eyebrow">Real Customers</span>
    <h2>{{ section.settings.heading }}</h2>

    <div class="bf-grid-3 bf-mt-32" style="margin-bottom:32px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="bf-review-card">
            <div class="bf-review-card__stars">★★★★★</div>
            <p style="margin:0 0 8px;">{{ block.settings.quote | default: '[PLACEHOLDER — verified review pending launch]' }}</p>
            <span class="bf-muted" style="font-size:0.8rem;">{{ block.settings.attribution | default: 'Verified Buyer — pending' }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <h3 class="bf-muted" style="font-size:0.85rem;letter-spacing:0.08em;text-transform:uppercase;">Customer stories</h3>
    <div class="bf-ugc-grid">
      {%- for i in (1..4) -%}
        <div class="bf-ugc-grid__slot">Customer stories coming soon</div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews & UGC",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "attribution", "label": "Attribution" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "review", "settings": {} },
      { "type": "review", "settings": {} },
      { "type": "review", "settings": {} }
    ]
  },
  "presets": [{ "name": "Reviews & UGC" }]
}
{% endschema %}
