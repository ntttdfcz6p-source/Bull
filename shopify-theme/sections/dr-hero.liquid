{% comment %} DR landing page hero — minimal, single CTA repeated, no nav. {% endcomment %}
<section class="bf-section bf-bg-black bf-hero" data-bf-hero>
  <div class="bf-container bf-text-center">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="bf-max-640" style="margin-left:auto;margin-right:auto;">{{ section.settings.headline }}</h1>
    <p class="bf-max-640" style="margin:0 auto 24px;">{{ section.settings.subheadline }}</p>
    <a href="#bf-purchase" class="bf-btn bf-btn--primary">{{ section.settings.cta_label }}</a>
    <div class="bf-hero__rating bf-text-center" style="justify-content:center;">
      <span class="bf-badge-placeholder">★★★★★ — reviews pending launch</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DR Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FUEL YOUR EDGE" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "YOUR DAILY EDGE." },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Premium male vitality support in a daily gummy format — with saffron, Panax ginseng, maca, and vitamin B6." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Choose Your Supply" }
  ],
  "presets": [{ "name": "DR Hero" }]
}
{% endschema %}
