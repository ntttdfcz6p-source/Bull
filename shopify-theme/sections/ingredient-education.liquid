{% comment %}
  Ingredient cards (texture-photo + dosage pill + overlay text) — layout
  pattern adapted from the competitor reference at the user's request. The
  "texture" backgrounds are CSS gradient placeholders standing in for real
  macro photography of each ingredient — see
  strategy/13-product-mockup-prompts.md for photography direction to
  replace them with. Dosage amounts are the confirmed per-serving actives
  from the formula spec (see strategy/14-facts-placeholders-legal.md).
{% endcomment %}
<section class="bf-section bf-bg-graphite">
  <div class="bf-container">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="bf-accent" style="font-family:var(--bf-font-display);text-transform:uppercase;letter-spacing:0.04em;font-size:0.95rem;">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="bf-grid-4 bf-mt-32">
      {%- for block in section.blocks -%}
        <div class="bf-ingredient-card">
          <div class="bf-ingredient-card__texture bf-texture-{{ forloop.index | modulo: 6 | plus: 1 }}"></div>
          <div class="bf-ingredient-card__content">
            <span class="bf-ingredient-card__dose">{{ block.settings.amount_placeholder }} / serving</span>
            <div class="bf-ingredient-card__name">{{ block.settings.name }}</div>
            <p class="bf-ingredient-card__role">{{ block.settings.role }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <p class="bf-muted" style="margin-top:20px;font-size:0.8rem;">
      {{ section.settings.footnote }} <a href="/pages/supplement-facts" style="color:var(--bf-white);">View full Supplement Facts panel</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient education",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Formula" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "4 Ingredients In 1 Focused Formula" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Transparent Doses, No Proprietary Blends" },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Amounts per serving are confirmed from the formula specification. Gummies-per-serving and total supply duration are pending the final Nutrition/Supplement Facts panel — do not publish a supply-duration claim until that's confirmed."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Ingredient name" },
        { "type": "textarea", "id": "role", "label": "Role / why it's included" },
        { "type": "text", "id": "amount_placeholder", "label": "Amount per serving", "default": "[PLACEHOLDER amount]" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "ingredient", "settings": { "name": "Saffron Extract", "role": "Included for its role in everyday mood and wellbeing support.", "amount_placeholder": "30 mg" } },
      { "type": "ingredient", "settings": { "name": "Panax Ginseng Extract", "role": "A traditionally used adaptogen included for energy and vitality support.", "amount_placeholder": "100 mg" } },
      { "type": "ingredient", "settings": { "name": "Maca Root Extract", "role": "Included for its traditional association with stamina and vitality.", "amount_placeholder": "300 mg" } },
      { "type": "ingredient", "settings": { "name": "Vitamin B6 (Pyridoxine HCl)", "role": "Supports normal energy-yielding metabolism.", "amount_placeholder": "2 mg" } }
    ]
  },
  "presets": [{ "name": "Ingredient education" }]
}
{% endschema %}
