<section class="bf-section bf-bg-graphite">
  <div class="bf-container">
    <span class="bf-eyebrow">The Product</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="bf-grid-3 bf-mt-32">
      {%- for block in section.blocks -%}
        <div class="bf-card">
          <div class="bf-card__number">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p class="bf-muted">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet BullRush Male Vitality Gummies" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "point", "settings": { "title": "What it is", "body": "A daily gummy formulated with saffron, Panax ginseng, maca, and vitamin B6 — one clear product, one clear routine." } },
      { "type": "point", "settings": { "title": "Who it's for", "body": "Adult men who want straightforward, premium support for everyday energy and vitality without a complicated regimen." } },
      { "type": "point", "settings": { "title": "How it fits your day", "body": "Take your dose daily — [PLACEHOLDER: exact serving instructions pending final label]." } }
    ]
  },
  "presets": [{ "name": "Product intro" }]
}
{% endschema %}
