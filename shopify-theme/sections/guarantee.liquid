{% comment %}
  Guarantee badge banner — visual pattern (circular badge + gradient
  banner) adapted from the competitor reference at the user's request (see
  strategy/01-brand-application-guide.md §7). The reference's badge reads
  "100% HIGHER T GUARANTEE" — a specific outcome guarantee BullRush cannot
  make. This version keeps the badge purely as a satisfaction/refund
  guarantee (money-back on the terms actually offered), never an outcome
  promise.
{% endcomment %}
<section class="bf-section bf-bg-white">
  <div class="bf-container">
    <div class="bf-guarantee-banner bf-reveal">
      <div class="bf-guarantee-banner__badge">
        <svg viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="2"/>
          <circle cx="60" cy="60" r="46" fill="none" stroke="currentColor" stroke-width="1"/>
          <text x="60" y="52" text-anchor="middle" font-family="{{ settings.font_display.family }}" font-size="20" fill="currentColor">{{ section.settings.days }}</text>
          <text x="60" y="70" text-anchor="middle" font-family="{{ settings.font_display.family }}" font-size="9" letter-spacing="1" fill="currentColor">DAY</text>
          <text x="60" y="84" text-anchor="middle" font-family="{{ settings.font_display.family }}" font-size="8" letter-spacing="0.5" fill="currentColor">GUARANTEE</text>
        </svg>
      </div>
      <div class="bf-guarantee-banner__content">
        <h2 style="color:var(--bf-white);margin-bottom:8px;">{{ section.settings.heading }}</h2>
        <p style="color:#e5e3df;margin-bottom:20px;">{{ section.settings.body }}</p>
        <a href="/pages/guarantee" class="bf-btn bf-btn--outline-dark">{{ section.settings.link_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    { "type": "text", "id": "days", "label": "Guarantee length (number)", "default": "30" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "30-Day Guarantee" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "If BullRush isn't right for you, contact us within 30 days of delivery for a refund on your first order." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Full Guarantee Terms" }
  ],
  "presets": [{ "name": "Guarantee" }]
}
{% endschema %}
