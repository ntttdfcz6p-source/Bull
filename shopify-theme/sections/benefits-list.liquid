{% comment %}
  Icon + benefit list in a bordered gradient panel — layout pattern adapted
  from the competitor reference at the user's request (see
  strategy/01-brand-application-guide.md §7). Copy is kept in BullRush's
  existing "support" framing rather than the reference's exaggerated
  "skyrocket / supercharge" language, per the brand guide's ban on
  hype-y "alpha male" style copy.
{% endcomment %}
<section class="bf-section bf-bg-black">
  <div class="bf-container" style="max-width:720px;">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="bf-benefits-panel bf-reveal">
      {%- for block in section.blocks -%}
        <div class="bf-benefit-item">
          <span class="bf-benefit-item__icon">
            {%- case block.settings.icon -%}
              {%- when 'bolt' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>
              {%- when 'target' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
              {%- when 'plus' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              {%- when 'flame' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 3c1 3-2 4-2 7a4 4 0 0 0 8 0c0-1-.5-2-1-2 .5 2-1 3-2 3-1.5 0-2-1.5-1-3-2 0-3 2-3 4a5 5 0 0 0 10 0C21 8 15 6 12 3z"/></svg>
              {%- when 'moon' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg>
            {%- endcase -%}
          </span>
          <div>
            <div class="bf-benefit-item__title">{{ block.settings.title }}</div>
            <p class="bf-benefit-item__sub">{{ block.settings.subtitle }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why It Matters" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to support the daily grind" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
            { "value": "bolt", "label": "Energy" },
            { "value": "target", "label": "Focus" },
            { "value": "plus", "label": "Vitality" },
            { "value": "flame", "label": "Drive" },
            { "value": "moon", "label": "Recovery" }
          ], "default": "bolt" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "benefit", "settings": { "icon": "bolt", "title": "Everyday Energy", "subtitle": "Support for steadier energy through the day" } },
      { "type": "benefit", "settings": { "icon": "plus", "title": "Male Vitality", "subtitle": "Formulated to support overall vitality" } },
      { "type": "benefit", "settings": { "icon": "target", "title": "Focus", "subtitle": "Support for staying sharp and on task" } },
      { "type": "benefit", "settings": { "icon": "flame", "title": "Drive & Confidence", "subtitle": "Part of a daily routine built for consistency" } },
      { "type": "benefit", "settings": { "icon": "moon", "title": "Recovery", "subtitle": "[PLACEHOLDER — pending substantiation for a recovery-specific claim]" } }
    ]
  },
  "presets": [{ "name": "Benefits list" }]
}
{% endschema %}
