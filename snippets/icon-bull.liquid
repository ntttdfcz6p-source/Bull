{% comment %}
  TEMPORARY LOGO — REPLACE BEFORE LAUNCH. Renders the BULLRUSH symbol mark.
  Uses a merchant-uploaded image if set in Theme settings → Logo; otherwise
  falls back to the bundled temporary abstract symbol (assets/bullrush-symbol-*.svg).
  Params:
    size: px, default 40
    background: "dark" | "light" (default "dark") — picks the color-correct variant
{% endcomment %}
{%- liquid
  assign icon_size = size | default: 40
  assign bg = background | default: 'dark'
  if bg == 'light'
    assign logo_image = settings.logo_symbol_only_light_bg
    assign fallback_asset = 'bullrush-symbol-light.svg'
  else
    assign logo_image = settings.logo_symbol_only_dark_bg
    assign fallback_asset = 'bullrush-symbol-dark.svg'
  endif
-%}
{%- if logo_image != blank -%}
  <img
    src="{{ logo_image | image_url: width: icon_size | times: 2 }}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    alt="BULLRUSH"
    loading="lazy"
    class="bf-icon-bull"
  >
{%- else -%}
  <img
    src="{{ fallback_asset | asset_url }}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    alt="BULLRUSH"
    loading="lazy"
    class="bf-icon-bull"
    style="object-fit:contain;"
  >
{%- endif -%}
