{% comment %}
  Renders the BullRush bull-head symbol. Uses a merchant-uploaded image if set
  in Theme settings → Logo; otherwise falls back to the real BullRush symbol
  bundled with the theme (derived from the supplied logo file — see
  README.md for how the dark/light variants were produced).
  Params:
    size: px, default 40
    background: "dark" | "light" (default "dark") — picks the color-correct variant
{% endcomment %}
{%- liquid
  assign icon_size = size | default: 40
  assign bg = background | default: 'dark'
  if bg == 'light'
    assign logo_image = settings.logo_symbol_only_light_bg
    assign fallback_asset = 'bullrush-symbol-light.png'
  else
    assign logo_image = settings.logo_symbol_only_dark_bg
    assign fallback_asset = 'bullrush-symbol-dark.png'
  endif
-%}
{%- if logo_image != blank -%}
  <img
    src="{{ logo_image | image_url: width: icon_size | times: 2 }}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    alt="BullRush"
    loading="lazy"
    class="bf-icon-bull"
  >
{%- else -%}
  <img
    src="{{ fallback_asset | asset_img_url: '400x' }}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    alt="BullRush"
    loading="lazy"
    class="bf-icon-bull"
    style="object-fit:contain;"
  >
{%- endif -%}
