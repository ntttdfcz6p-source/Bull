{% comment %}
  TEMPORARY LOGO — REPLACE BEFORE LAUNCH. Renders the BULLRUSH wordmark
  lockup: a simple bold-uppercase text logo bundled with the theme
  (assets/bullrush-{horizontal,stacked}-*.svg). Uses a merchant-uploaded
  image if set in Theme settings → Logo for the requested
  background/orientation instead.
  Params:
    background: "dark" | "light" (default "dark")
    layout: "horizontal" | "stacked" (default "horizontal")
{% endcomment %}
{%- liquid
  assign bg = background | default: 'dark'
  assign lay = layout | default: 'horizontal'
  if lay == 'stacked'
    assign fallback_aspect_ratio = 1.678657
  else
    assign fallback_aspect_ratio = 5.732484
  endif
  if bg == 'light'
    if lay == 'stacked'
      assign logo_image = settings.logo_stacked_light_bg
      assign fallback_asset = 'bullrush-stacked-light.svg'
    else
      assign logo_image = settings.logo_horizontal_light_bg
      assign fallback_asset = 'bullrush-horizontal-light.svg'
    endif
  else
    if lay == 'stacked'
      assign logo_image = settings.logo_stacked_dark_bg
      assign fallback_asset = 'bullrush-stacked-dark.svg'
    else
      assign logo_image = settings.logo_horizontal_dark_bg
      assign fallback_asset = 'bullrush-horizontal-dark.svg'
    endif
  endif
  if logo_image != blank
    assign logo_height = settings.logo_width | divided_by: logo_image.aspect_ratio | round
  else
    assign logo_height = settings.logo_width | divided_by: fallback_aspect_ratio | round
  endif
-%}
{%- if logo_image != blank -%}
  <img
    src="{{ logo_image | image_url: width: settings.logo_width | times: 2 }}"
    width="{{ settings.logo_width }}"
    height="{{ logo_height }}"
    alt="BULLRUSH"
    loading="eager"
    class="bf-logo bf-logo--{{ lay }}"
  >
{%- else -%}
  <img
    src="{{ fallback_asset | asset_url }}"
    width="{{ settings.logo_width }}"
    height="{{ logo_height }}"
    alt="BULLRUSH"
    loading="eager"
    class="bf-logo bf-logo--{{ lay }}"
  >
{%- endif -%}
