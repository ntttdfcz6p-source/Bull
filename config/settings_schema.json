[
  {
    "name": "theme_info",
    "theme_name": "BullRush",
    "theme_version": "0.1.0",
    "theme_author": "BullRush",
    "theme_documentation_url": "https://example.com/bullrush-theme-docs",
    "theme_support_email": "support@bullrush.example"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "header",
        "content": "Logo lockups"
      },
      {
        "type": "paragraph",
        "content": "Upload each lockup to override the theme's built-in default (derived from the real BullRush logo). Every section pulls the correct version automatically based on its background."
      },
      {
        "type": "image_picker",
        "id": "logo_horizontal_dark_bg",
        "label": "Horizontal logo — for dark backgrounds",
        "info": "Defaults to bullrush-horizontal-dark.png (bundled) if left blank"
      },
      {
        "type": "image_picker",
        "id": "logo_horizontal_light_bg",
        "label": "Horizontal logo — for light backgrounds",
        "info": "Defaults to bullrush-horizontal-light.png (bundled) if left blank"
      },
      {
        "type": "image_picker",
        "id": "logo_stacked_dark_bg",
        "label": "Stacked logo — for dark backgrounds",
        "info": "Defaults to bullrush-stacked-dark.png (bundled) if left blank"
      },
      {
        "type": "image_picker",
        "id": "logo_stacked_light_bg",
        "label": "Stacked logo — for light backgrounds",
        "info": "Defaults to bullrush-stacked-light.png (bundled) if left blank"
      },
      {
        "type": "image_picker",
        "id": "logo_symbol_only_dark_bg",
        "label": "Symbol only (bull head) — for dark backgrounds",
        "info": "Defaults to bullrush-symbol-dark.png (bundled) if left blank"
      },
      {
        "type": "image_picker",
        "id": "logo_symbol_only_light_bg",
        "label": "Symbol only (bull head) — for light backgrounds / favicon source",
        "info": "Defaults to bullrush-symbol-light.png (bundled) if left blank"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 260,
        "step": 10,
        "unit": "px",
        "label": "Desktop header logo width",
        "default": 160
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "BullRush palette (rebrand 2026-08-04)"
      },
      {
        "type": "paragraph",
        "content": "Bold/aggressive/futuristic direction: acid green + electric cyan on black, replacing the earlier red/black palette. See strategy/01-brand-application-guide.md §9."
      },
      { "type": "color", "id": "color_primary_black", "label": "Primary Black", "default": "#080808" },
      { "type": "color", "id": "color_soft_black", "label": "Soft Black", "default": "#151515" },
      { "type": "color", "id": "color_dark_surface", "label": "Dark Surface (internal, card borders on dark bg)", "default": "#202020" },
      { "type": "color", "id": "color_acid_green", "label": "Acid Green (primary accent — CTAs, badges, emphasis)", "default": "#C8FF00" },
      { "type": "color", "id": "color_acid_green_deep", "label": "Acid Green Deep (hover/pressed shade, derived)", "default": "#A0CC00" },
      { "type": "color", "id": "color_electric_cyan", "label": "Electric Cyan (secondary accent — panels, patterns)", "default": "#66D9E8" },
      { "type": "color", "id": "color_electric_cyan_deep", "label": "Electric Cyan Deep (hover shade, derived)", "default": "#52AEBA" },
      { "type": "color", "id": "color_white", "label": "White", "default": "#FFFFFF" },
      { "type": "color", "id": "color_light_gray", "label": "Light Gray (short visual reset only — never several sections in a row)", "default": "#F2F2F2" },
      { "type": "color", "id": "color_muted_gray", "label": "Muted Gray", "default": "#8B8B8B" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_display",
        "label": "Display / headline font",
        "default": "archivo_black_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body / UI font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Cart & Purchase",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_sticky_cta",
        "label": "Enable sticky mobile purchase bar",
        "default": true
      },
      {
        "type": "text",
        "id": "guarantee_text",
        "label": "Guarantee note shown in purchase module",
        "default": "30-day satisfaction guarantee"
      },
      {
        "type": "text",
        "id": "shipping_note",
        "label": "Shipping note shown in purchase module",
        "default": "Free shipping on Subscribe & Save orders"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "header", "content": "Social links (footer)" },
      { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "url", "id": "social_youtube", "label": "YouTube URL" }
    ]
  }
]
