<section class="bf-section bf-bg-black bf-text-center" style="min-height:70vh;display:flex;align-items:center;justify-content:center;">
  <div class="bf-container bf-max-640">
    {% render 'logo-wordmark', background: 'dark', layout: 'stacked' %}
    <h1 class="bf-mt-32">{{ section.settings.heading }}</h1>
    <p class="bf-muted">{{ section.settings.body }}</p>

    {%- if shop.password_message != blank -%}
      <div class="bf-muted">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div class="bf-placeholder-note" style="margin:16px auto;max-width:360px;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display:flex;gap:12px;justify-content:center;margin-top:20px;flex-wrap:wrap;">
        <input type="password" name="password" placeholder="Enter store password" style="padding:12px;border-radius:4px;border:1px solid #444;min-width:220px;">
        <button type="submit" class="bf-btn bf-btn--primary">Enter</button>
      </div>
    {%- endform -%}

    <div class="bf-mt-32">
      <p class="bf-muted" style="margin-bottom:12px;">{{ section.settings.notify_heading }}</p>
      {%- form 'customer' -%}
        {%- if form.posted_successfully? -%}
          <p class="bf-badge-placeholder" style="display:inline-block;padding:12px;">Thanks — we'll let you know.</p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="prospect,password_page">
          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
            <input type="email" name="contact[email]" placeholder="Email address" required style="padding:12px;border-radius:4px;border:1px solid #444;min-width:220px;">
            <button type="submit" class="bf-btn bf-btn--outline-dark">Notify Me</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Main password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We'll be back soon." },
    { "type": "text", "id": "body", "label": "Body text", "default": "BULLRUSH is getting ready to launch." },
    { "type": "text", "id": "notify_heading", "label": "Notify signup heading", "default": "Want to know when we launch?" }
  ]
}
{% endschema %}
