{% comment %}
  Split-screen problem section: text/stats/chart on one side, a black-and-
  white lifestyle image placeholder on the other (per the redesign brief's
  "split-screen composition... scroll-triggered number animations").

  Two lines are rendered in the chart:
    1. "General population" — must be backed by a real, cited statistic
       before publishing (the axis/curve here is illustrative until then).
    2. "With BullRush" — per explicit instruction, included but rendered
       dashed and labeled [PLACEHOLDER] — this is a specific efficacy claim
       with ZERO clinical backing right now. Do NOT remove the placeholder
       label or make this line solid/uncaveated without real clinical
       substantiation and legal sign-off. See
       strategy/14-facts-placeholders-legal.md.

  The animated "oversized statistic" counters only render when a merchant
  fills in a real number — they ship blank, never a fabricated 0% or a
  placeholder number that would animate as if it were real.
{% endcomment %}
<div class="bf-split">
  <div class="bf-split__content bf-bg-black">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="bf-muted" style="margin-bottom:24px;">{{ section.settings.framing_note }}</p>

    {%- if section.settings.stat_1_number != blank or section.settings.stat_2_number != blank -%}
      <div style="display:flex;gap:40px;flex-wrap:wrap;margin-bottom:28px;" class="bf-reveal">
        {%- if section.settings.stat_1_number != blank -%}
          <div>
            <div class="bf-stat-number" data-bf-counter="{{ section.settings.stat_1_number }}" data-bf-counter-suffix="{{ section.settings.stat_1_suffix }}">0{{ section.settings.stat_1_suffix }}</div>
            <div class="bf-stat-label">{{ section.settings.stat_1_label }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.stat_2_number != blank -%}
          <div>
            <div class="bf-stat-number" data-bf-counter="{{ section.settings.stat_2_number }}" data-bf-counter-suffix="{{ section.settings.stat_2_suffix }}">0{{ section.settings.stat_2_suffix }}</div>
            <div class="bf-stat-label">{{ section.settings.stat_2_label }}</div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bf-chart-wrap bf-reveal" style="margin:0 0 24px;">
      <div class="bf-chart-legend">
        <span class="bf-chart-legend__item"><span class="bf-chart-legend__swatch bf-chart-legend__swatch--population"></span> {{ section.settings.population_legend }}</span>
        <span class="bf-chart-legend__item"><span class="bf-chart-legend__swatch bf-chart-legend__swatch--placeholder"></span> {{ section.settings.product_legend }} — [PLACEHOLDER, unsubstantiated]</span>
      </div>
      <div class="bf-chart">
        <svg viewBox="0 0 600 320" preserveAspectRatio="xMidYMid meet">
          <line x1="50" y1="20" x2="50" y2="270" stroke="{{ settings.color_muted_gray }}" stroke-width="1"/>
          <line x1="50" y1="270" x2="580" y2="270" stroke="{{ settings.color_muted_gray }}" stroke-width="1"/>
          {%- for i in (0..4) -%}
            <line x1="50" y1="{{ i | times: 62.5 | plus: 20 }}" x2="580" y2="{{ i | times: 62.5 | plus: 20 }}" stroke="{{ settings.color_dark_surface }}" stroke-width="1"/>
          {%- endfor -%}
          <polyline points="70,90 180,110 290,150 400,190 510,225" fill="none" stroke="{{ settings.color_muted_gray }}" stroke-width="2.5"/>
          <polyline points="70,90 180,85 290,82 400,80 510,78" fill="none" stroke="{{ settings.color_acid_green }}" stroke-width="2.5" stroke-dasharray="6 5"/>
          <text x="50" y="285" font-size="10" fill="{{ settings.color_muted_gray }}">{{ section.settings.x_axis_start }}</text>
          <text x="565" y="285" font-size="10" fill="{{ settings.color_muted_gray }}" text-anchor="end">{{ section.settings.x_axis_end }}</text>
          <text x="20" y="24" font-size="10" fill="{{ settings.color_muted_gray }}">{{ section.settings.y_axis_label }}</text>
        </svg>
      </div>
      <p class="bf-chart-caption">{{ section.settings.chart_caption }}</p>
    </div>

    <div class="bf-reveal">
      {%- for block in section.blocks -%}
        <div class="bf-proof-item">
          <span class="bf-proof-item__mark">—</span>
          <div>
            <p style="margin:0 0 6px;">{{ block.settings.stat }}</p>
            <span class="bf-cite bf-muted">Source: {{ block.settings.source | default: '[PLACEHOLDER — citation required before publishing]' }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="bf-split__media">
    {%- if section.settings.lifestyle_image != blank -%}
      <img src="{{ section.settings.lifestyle_image | image_url: width: 1000 }}" alt="" loading="lazy" style="filter:grayscale(1) contrast(1.1);">
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,8,8,0.15),rgba(8,8,8,0.75));"></div>
    {%- else -%}
      <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--bf-muted-gray);font-size:0.85rem;text-align:center;padding:24px;background:var(--bf-soft-black);">
        TEMPORARY ASSET — REPLACE BEFORE LAUNCH<br>Black-and-white lifestyle photography
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Problem proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Reality" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Everyday Reality For A Lot Of Men" },
    {
      "type": "textarea",
      "id": "framing_note",
      "label": "Framing note (keeps this separate from BullRush outcome claims — do not remove)",
      "default": "These are general population statistics, not a claim about what BullRush itself produces for any individual."
    },
    { "type": "image_picker", "id": "lifestyle_image", "label": "Lifestyle image — TEMPORARY ASSET, replace before launch" },
    { "type": "header", "content": "Oversized stat counters (leave number blank until a real, cited figure exists)" },
    { "type": "text", "id": "stat_1_number", "label": "Stat 1 number (digits only, e.g. 68)" },
    { "type": "text", "id": "stat_1_suffix", "label": "Stat 1 suffix", "default": "%" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "[PLACEHOLDER — pending cited statistic]" },
    { "type": "text", "id": "stat_2_number", "label": "Stat 2 number" },
    { "type": "text", "id": "stat_2_suffix", "label": "Stat 2 suffix", "default": "%" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "[PLACEHOLDER — pending cited statistic]" },
    { "type": "text", "id": "population_legend", "label": "Population line legend", "default": "General population" },
    { "type": "text", "id": "product_legend", "label": "Product line legend", "default": "With BullRush" },
    { "type": "text", "id": "x_axis_start", "label": "X-axis start label", "default": "20s" },
    { "type": "text", "id": "x_axis_end", "label": "X-axis end label", "default": "60s" },
    { "type": "text", "id": "y_axis_label", "label": "Y-axis label", "default": "[PLACEHOLDER METRIC — pending cited statistic]" },
    {
      "type": "textarea",
      "id": "chart_caption",
      "label": "Chart caption",
      "default": "Illustrative chart. The general-population curve requires a cited source before publishing; the \"With BullRush\" line is a placeholder and must not be shown as fact without clinical substantiation and legal review."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        { "type": "textarea", "id": "stat", "label": "Statistic", "default": "[PLACEHOLDER — insert a credible, cited statistic on adult male fatigue/stress/energy decline]" },
        { "type": "text", "id": "source", "label": "Source citation (required)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "stat", "settings": {} },
      { "type": "stat", "settings": {} }
    ]
  },
  "presets": [{ "name": "Problem proof" }]
}
{% endschema %}
