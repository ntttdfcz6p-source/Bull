{% comment %}
  Two-column hero per the redesign brief: headline left, product visual
  right on a cyan panel with an acid-green dot pattern, oversized cropped
  background typography, and subtle cursor-parallax on the product image
  (desktop pointer only; disabled under prefers-reduced-motion — see
  assets/bullrush.js).
{% endcomment %}
<section class="bf-section bf-bg-black bf-hero" data-bf-hero style="position:relative;overflow:hidden;">
  <div class="bf-oversized-bg" aria-hidden="true">{{ section.settings.bg_word }}</div>
  <div class="bf-container bf-hero__grid" style="position:relative;z-index:1;">
    <div>
      <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.headline }}</h1>
      <p style="max-width:480px;">{{ section.settings.subheadline }}</p>

      <div class="bf-hero__rating" style="margin-top:16px;">
        <span class="bf-badge-placeholder">★★★★★ — reviews pending launch</span>
      </div>

      {%- if section.settings.chip_1 != blank or section.settings.chip_2 != blank or section.settings.chip_3 != blank -%}
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;">
          {%- for chip in section.settings.chip_1, section.settings.chip_2, section.settings.chip_3 -%}
            {%- if chip != blank -%}
              <span class="bf-badge-amount">{{ chip }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="bf-cta-row">
        <a href="#bf-purchase" class="bf-btn bf-btn--primary bf-btn--arrow">{{ section.settings.cta_label }} <span class="bf-btn__arrow">→</span></a>
        <a href="{{ section.settings.secondary_url }}" class="bf-btn bf-btn--outline-dark">{{ section.settings.secondary_label }}</a>
      </div>

      <p class="bf-muted" style="font-size:0.78rem;margin-top:18px;margin-bottom:0;">{{ section.settings.guarantee_text }} · {{ section.settings.shipping_text }}</p>
    </div>

    <div class="bf-hero__media bf-bg-cyan bf-pattern-dots" data-bf-cursor-zone style="aspect-ratio:1/1;position:relative;">
      <div class="bf-cursor-parallax" style="width:60%;">
        {%- if section.settings.hero_image != blank -%}
          <img src="{{ section.settings.hero_image | image_url: width: 900 }}" alt="BullRush Male Vitality Gummies" loading="eager">
        {%- else -%}
          {% render 'icon-bull', size: 280, background: 'light' %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero — Brand",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FUEL YOUR POWER" },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap a word in <span class=\"bf-accent\">word</span> to highlight it in acid green.",
      "default": "POWER YOUR <span class=\"bf-accent\">DRIVE</span>."
    },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Daily gummies with saffron, Panax ginseng, maca, and vitamin B6 — formulated to support male vitality, energy, and everyday performance." },
    { "type": "text", "id": "bg_word", "label": "Oversized background word (decorative)", "default": "POWER" },
    { "type": "text", "id": "chip_1", "label": "Benefit chip 1", "default": "Daily Energy" },
    { "type": "text", "id": "chip_2", "label": "Benefit chip 2", "default": "Focus" },
    { "type": "text", "id": "chip_3", "label": "Benefit chip 3", "default": "Male Vitality" },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Shop Now" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA label", "default": "Explore The Formula" },
    { "type": "url", "id": "secondary_url", "label": "Secondary CTA link" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "90-day guarantee" },
    { "type": "text", "id": "shipping_text", "label": "Shipping note", "default": "Free shipping on Subscribe & Save" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero product image — TEMPORARY ASSET, replace before launch" }
  ],
  "presets": [{ "name": "Hero — Brand" }]
}
{% endschema %}
