{% comment %}
  Solution section — "one daily habit, multiple performance benefits."
  Six interactive tilt-hover cards. Copy stays in compliant "supports /
  formulated to support / helps maintain" language throughout — never
  "treats," "cures," "guarantees," or "increases testosterone/hormone
  levels." See REPLACE-BEFORE-LAUNCH.md.
{% endcomment %}
<section class="bf-section bf-bg-black">
  <div class="bf-container">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="bf-grid-3 bf-mt-32 bf-reveal">
      {%- for block in section.blocks -%}
        <div class="bf-tilt-card">
          <span class="bf-tilt-card__icon">
            {%- case block.settings.icon -%}
              {%- when 'bolt' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>
              {%- when 'target' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
              {%- when 'plus' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              {%- when 'flame' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 3c1 3-2 4-2 7a4 4 0 0 0 8 0c0-1-.5-2-1-2 .5 2-1 3-2 3-1.5 0-2-1.5-1-3-2 0-3 2-3 4a5 5 0 0 0 10 0C21 8 15 6 12 3z"/></svg>
              {%- when 'moon' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg>
            {%- endcase -%}
          </span>
          <div class="bf-tilt-card__title">{{ block.settings.title }}</div>
          <p class="bf-tilt-card__body">{{ block.settings.subtitle }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Solution — benefit cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Solution" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One Daily Habit. Multiple Performance Benefits." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
            { "value": "bolt", "label": "Energy" },
            { "value": "target", "label": "Focus" },
            { "value": "plus", "label": "Vitality" },
            { "value": "flame", "label": "Drive / strength" },
            { "value": "moon", "label": "Recovery" },
            { "value": "shield", "label": "Daily performance" }
          ], "default": "bolt" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "benefit", "settings": { "icon": "bolt", "title": "Energy Support", "subtitle": "Formulated to support steadier energy through the day" } },
      { "type": "benefit", "settings": { "icon": "flame", "title": "Strength Support", "subtitle": "Part of a daily routine built to support training consistency" } },
      { "type": "benefit", "settings": { "icon": "target", "title": "Focus", "subtitle": "Helps support staying sharp and on task" } },
      { "type": "benefit", "settings": { "icon": "moon", "title": "Recovery", "subtitle": "[PLACEHOLDER — pending substantiation for a recovery-specific claim]" } },
      { "type": "benefit", "settings": { "icon": "plus", "title": "Male Vitality", "subtitle": "Formulated to support overall male vitality" } },
      { "type": "benefit", "settings": { "icon": "shield", "title": "Daily Performance", "subtitle": "Designed for consistent, everyday performance — not a one-off boost" } }
    ]
  },
  "presets": [{ "name": "Solution — benefit cards" }]
}
{% endschema %}
