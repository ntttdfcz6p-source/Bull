{% comment %}
  Free-gift unlock section — cart-total progress bar with editable
  thresholds per gift. Renders with the real live cart total on first
  paint (cart.total_price, no fabricated numbers) and updates live via JS
  after every add-to-cart / quantity change (listens for the
  "bf:cart:updated" event dispatched in bullrush.js). All gift items below
  are TEMPORARY PLACEHOLDERS — replace with real bonus items before launch.
{% endcomment %}
{%- liquid
  assign max_threshold = 0
  for block in section.blocks
    if block.settings.threshold > max_threshold
      assign max_threshold = block.settings.threshold
    endif
  endfor
  assign cart_total_dollars = cart.total_price | divided_by: 100.0
-%}
<section class="bf-section bf-bg-charcoal" data-bf-gift-progress data-max="{{ max_threshold }}">
  <div class="bf-container">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="bf-muted" style="max-width:560px;">{{ section.settings.subheading }}</p>

    <div class="bf-gift-track bf-mt-32" style="position:relative;">
      <div class="bf-progress-bar" style="margin:28px 0 44px;">
        <div class="bf-progress-bar__fill" data-bf-gift-progress-fill style="width:{% if max_threshold > 0 %}{{ cart_total_dollars | times: 100 | divided_by: max_threshold | at_most: 100 }}{% else %}0{% endif %}%;"></div>
      </div>
      <div class="bf-gift-grid">
        {%- for block in section.blocks -%}
          <div class="bf-gift-card" data-bf-gift-card data-threshold="{{ block.settings.threshold }}">
            <div class="bf-gift-card__icon">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 200 }}" width="64" height="{{ 64 | divided_by: block.settings.image.aspect_ratio | round }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M3 12h18M12 8v13"/><path d="M12 8c-2 0-4-1-4-3a2 2 0 0 1 4 0 2 2 0 0 1 4 0c0 2-2 3-4 3z"/></svg>
              {%- endif -%}
            </div>
            <p class="bf-gift-card__threshold">{{ block.settings.threshold | times: 100 | money_without_trailing_zeros }}+</p>
            <p class="bf-gift-card__title">{{ block.settings.title }}</p>
            <span class="bf-badge-placeholder" data-bf-gift-status>{% if cart_total_dollars >= block.settings.threshold %}Unlocked{% else %}Locked{% endif %}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
    <p class="bf-muted" style="font-size:0.72rem;margin-top:16px;">{{ section.settings.disclosure }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Gifts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free Gifts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unlock Free Gifts As You Build Your Order" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Add more to your cart to unlock these bonuses automatically at checkout." },
    {
      "type": "textarea",
      "id": "disclosure",
      "label": "Disclosure",
      "default": "[PLACEHOLDER] Gift items and thresholds shown are temporary placeholders — confirm real bonus items, stock, and cart-total logic before launch."
    }
  ],
  "blocks": [
    {
      "type": "gift",
      "name": "Gift",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Gift image (optional)" },
        { "type": "text", "id": "title", "label": "Gift name" },
        { "type": "number", "id": "threshold", "label": "Unlock at cart total ($)", "default": 50 }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "gift", "settings": { "title": "Digital Performance Guide", "threshold": 50 } },
      { "type": "gift", "settings": { "title": "Travel Case", "threshold": 75 } },
      { "type": "gift", "settings": { "title": "Training Plan", "threshold": 100 } },
      { "type": "gift", "settings": { "title": "Bonus Product", "threshold": 150 } }
    ]
  },
  "presets": [{ "name": "Gifts" }]
}
{% endschema %}
