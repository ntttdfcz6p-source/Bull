<section class="bf-section bf-bg-offwhite" id="faq">
  <div class="bf-container bf-max-640">
    <span class="bf-eyebrow">FAQ</span>
    <h2>{{ section.settings.heading }}</h2>
    <div>
      {%- for block in section.blocks -%}
        <div class="bf-accordion__item" data-bf-accordion-item>
          <button type="button" class="bf-accordion__trigger" data-bf-accordion-trigger aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="bf-accordion__icon">+</span>
          </button>
          <div class="bf-accordion__panel" data-bf-accordion-panel data-open="false">
            <p class="bf-muted">{{ block.settings.answer }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "faq_item", "settings": { "question": "What is BULLRUSH?", "answer": "BULLRUSH Testosterone Support Gummies is a daily men's performance supplement formulated to support energy, focus, strength, recovery and male vitality." } },
      { "type": "faq_item", "settings": { "question": "Who is it for?", "answer": "Adult men looking for straightforward, premium support for everyday energy and performance as part of a daily routine." } },
      { "type": "faq_item", "settings": { "question": "How should I take it?", "answer": "[PLACEHOLDER — exact usage instructions pending final label]." } },
      { "type": "faq_item", "settings": { "question": "Is this a subscription?", "answer": "You can buy one-time or subscribe. Subscribe & Save shows the recurring price and delivery frequency before you commit, and you can skip, pause, or cancel anytime from your account." } },
      { "type": "faq_item", "settings": { "question": "Can I cancel?", "answer": "Yes — cancel your subscription anytime from your account before the next billing date. No phone calls required." } },
      { "type": "faq_item", "settings": { "question": "What ingredients are included?", "answer": "Tongkat Ali, Shilajit, Ashwagandha, Zinc, Vitamin D, Boron, Fenugreek and Magnesium. Full Supplement Facts panel is available on the Formula page once finalized." } },
      { "type": "faq_item", "settings": { "question": "Does it contain sugar?", "answer": "[PLACEHOLDER — pending final Nutrition/Supplement Facts panel]." } },
      { "type": "faq_item", "settings": { "question": "Where is it made?", "answer": "[PLACEHOLDER — manufacturing location pending final label]." } },
      { "type": "faq_item", "settings": { "question": "Is it tested?", "answer": "[PLACEHOLDER — Certificate of Analysis available on request from the manufacturer; not yet in hand — do not publish as confirmed until received]." } },
      { "type": "faq_item", "settings": { "question": "When should I take it?", "answer": "[PLACEHOLDER — timing guidance pending final label/formulator input]." } },
      { "type": "faq_item", "settings": { "question": "What is the refund policy?", "answer": "90-day money-back guarantee on your first order — see our Refund Policy for full terms." } }
    ]
  },
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
