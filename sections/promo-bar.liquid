{% comment %}
  Sticky announcement bar with rotating, block-based messages. Unlike a
  fabricated countdown, the optional countdown reads a real merchant-set
  end date/time — if none is set, or it's in the past, the bar shows the
  rotating messages with no countdown rather than faking urgency. Never
  hardcode a countdown here.
{% endcomment %}
{%- if section.settings.enable_bar and section.blocks.size > 0 -%}
  <div
    class="bf-promo-bar"
    data-bf-promo-bar
    {% if section.settings.end_datetime != blank %}data-end="{{ section.settings.end_datetime }}"{% endif %}
    style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"
  >
    <div class="bf-promo-bar__message">
      <div class="bf-announce-rotator" data-bf-announce-rotator>
        {%- for block in section.blocks -%}
          <span class="bf-announce-rotator__item" data-bf-announce-item {% if forloop.first %}data-active="true"{% else %}data-active="false"{% endif %}>{{ block.settings.message }}</span>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.settings.end_datetime != blank -%}
      <div class="bf-countdown" data-bf-countdown>
        <div class="bf-countdown__unit"><span class="bf-countdown__unit-value" data-unit="hours">00</span><span class="bf-countdown__unit-label">Hrs</span></div>
        <div class="bf-countdown__unit"><span class="bf-countdown__unit-value" data-unit="minutes">00</span><span class="bf-countdown__unit-label">Min</span></div>
        <div class="bf-countdown__unit"><span class="bf-countdown__unit-value" data-unit="seconds">00</span><span class="bf-countdown__unit-label">Sec</span></div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enable_bar", "label": "Enable announcement bar", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#070707" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#F4F1E9" },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "Real promotion end date/time (ISO 8601, e.g. 2026-08-31T23:59:00)",
      "info": "Must be a genuine end time for an actual promotion. Leave blank to show the rotating messages with no countdown — never fill this with a fake or recurring date."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "message", "label": "Message" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "message": "LIMITED LAUNCH OFFER — SAVE 50%" } },
      { "type": "message", "settings": { "message": "FREE SHIPPING ON MULTI-BOTTLE ORDERS" } },
      { "type": "message", "settings": { "message": "90-DAY MONEY-BACK GUARANTEE" } },
      { "type": "message", "settings": { "message": "BUILT FOR MEN WHO REFUSE TO SLOW DOWN" } }
    ]
  },
  "presets": [{ "name": "Announcement bar", "blocks": [
    { "type": "message", "settings": { "message": "LIMITED LAUNCH OFFER — SAVE 50%" } },
    { "type": "message", "settings": { "message": "FREE SHIPPING ON MULTI-BOTTLE ORDERS" } },
    { "type": "message", "settings": { "message": "90-DAY MONEY-BACK GUARANTEE" } },
    { "type": "message", "settings": { "message": "BUILT FOR MEN WHO REFUSE TO SLOW DOWN" } }
  ] }]
}
{% endschema %}
