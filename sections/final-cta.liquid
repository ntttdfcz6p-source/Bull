{% comment %}
  Large cinematic final CTA: dark lifestyle photo background, floating
  product shot, headline, and a compact trust row (rating, guarantee,
  shipping). TEMPORARY ASSETS — bundled fallbacks are original placeholder
  graphics, replace before launch via this section's image settings.
{% endcomment %}
<section class="bf-section bf-bg-black bf-text-center bf-pattern-dots-corner" style="position:relative;overflow:hidden;">
  {%- if section.settings.bg_image != blank -%}
    <div style="position:absolute;inset:0;z-index:0;">
      <img src="{{ section.settings.bg_image | image_url: width: 1800 }}" width="1800" height="{{ 1800 | divided_by: section.settings.bg_image.aspect_ratio | round }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;filter:grayscale(0.3);">
      <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 30%,rgba(7,7,7,0.55),rgba(7,7,7,0.94));"></div>
    </div>
  {%- endif -%}
  <div class="bf-container" style="position:relative;z-index:1;">
    <div class="bf-glow" style="width:180px;margin:0 auto 20px;">
      {%- if section.settings.product_image != blank -%}
        <img src="{{ section.settings.product_image | image_url: width: 400 }}" width="180" height="{{ 180 | divided_by: section.settings.product_image.aspect_ratio | round }}" alt="BULLRUSH Testosterone Support Gummies" loading="lazy" class="bf-float">
      {%- else -%}
        <img src="{{ 'temporary-product-01.webp' | asset_url }}" width="180" height="180" alt="BULLRUSH Testosterone Support Gummies — temporary placeholder image" loading="lazy" class="bf-float">
      {%- endif -%}
    </div>
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="bf-max-640" style="margin:0 auto 28px;color:var(--bf-light-gray);">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.cta_url | default: '#bf-purchase' }}" class="bf-btn bf-btn--primary">{{ section.settings.cta_label }}</a>
    <div class="bf-final-cta__trust">
      <span>★★★★★ {{ section.settings.rating }} ({{ section.settings.review_count }} reviews — placeholder)</span>
      <span>{{ section.settings.guarantee_text }}</span>
      <span>{{ section.settings.shipping_text }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background lifestyle photo — TEMPORARY ASSET, replace before launch" },
    { "type": "image_picker", "id": "product_image", "label": "Product image — TEMPORARY ASSET, replace before launch" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Last Call" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop Running On Empty." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "One daily habit, formulated to support energy, focus, strength, recovery and male vitality." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop BULLRUSH" },
    { "type": "url", "id": "cta_url", "label": "CTA link", "info": "Defaults to the purchase module on this page if left blank" },
    { "type": "text", "id": "rating", "label": "Rating (placeholder)", "default": "4.8/5" },
    { "type": "text", "id": "review_count", "label": "Review count (placeholder)", "default": "1,200+" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "90-day money-back guarantee" },
    { "type": "text", "id": "shipping_text", "label": "Shipping note", "default": "Free shipping on multi-bottle orders" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
