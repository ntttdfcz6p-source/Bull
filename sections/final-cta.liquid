<section class="bf-section bf-bg-black bf-text-center bf-pattern-dots-corner" style="position:relative;overflow:hidden;">
  <div class="bf-container">
    <span class="bf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <a href="#bf-purchase" class="bf-btn bf-btn--primary">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FUEL YOUR POWER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your routine starts today." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Get BullRush" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
