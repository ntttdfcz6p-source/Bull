{% comment %}
  Generic collection grid. This store is a focused single-product funnel with
  no merchandised collections in the nav, but Shopify always routes
  /collections/* (including the automatic "Frontpage"/"All" collections) to
  this template, so it needs to render correctly rather than 404.
{% endcomment %}
<section class="bf-section bf-bg-white">
  <div class="bf-container">
    <div class="bf-text-center" style="margin-bottom:32px;">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="bf-muted bf-max-640" style="margin:12px auto 0;">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size == 0 -%}
        <p class="bf-muted bf-text-center">No products found in this collection yet.</p>
      {%- else -%}
        <div class="bf-grid-3">
          {%- for product in collection.products -%}
            <a href="{{ product.url }}" class="bf-card" style="display:block;text-decoration:none;color:inherit;">
              <div style="aspect-ratio:1/1;background:var(--bf-light-gray);border-radius:6px;overflow:hidden;margin-bottom:12px;">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 500 }}" width="500" height="{{ 500 | divided_by: product.featured_image.aspect_ratio | round }}" alt="{{ product.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
                {%- else -%}
                  {% render 'icon-bull', size: 80 %}
                {%- endif -%}
              </div>
              <p style="margin:0;font-weight:600;">{{ product.title }}</p>
              <p class="bf-muted" style="margin:4px 0 0;">{{ product.price | money }}</p>
            </a>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="bf-text-center bf-mt-32" style="display:flex;gap:12px;justify-content:center;">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="bf-btn bf-btn--outline-light">Previous</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="bf-btn bf-btn--outline-light">Next</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Main collection" }
{% endschema %}
