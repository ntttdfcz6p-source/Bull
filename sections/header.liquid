{%- comment -%}
  Auto-minimal on the DR landing page and the product offer page templates
  (per the brief: those two surfaces should drop full nav to remove
  distractions after the buy decision). Falls back to the manual
  section setting on any other template.

  Includes a real mobile nav drawer (hamburger → slide-in panel with
  collapsible groups for two-level menus) — the theme previously had no
  mobile navigation at all below 860px, just a hidden nav with no
  replacement. Pattern inspired by the competitor reference at the user's
  request; see strategy/01-brand-application-guide.md §7.
{%- endcomment -%}
{%- liquid
  assign is_focused_template = false
  if template.suffix == 'landing-page' or template.suffix == 'offer'
    assign is_focused_template = true
  endif
  assign minimal = section.settings.minimal_nav
  if is_focused_template
    assign minimal = true
  endif
-%}
<header class="bf-header {% if minimal %}bf-header--minimal{% endif %}">
  <div class="bf-header__inner">
    {%- unless minimal -%}
      <button type="button" class="bf-hamburger" data-bf-hamburger aria-expanded="false" aria-controls="bf-nav-drawer" aria-label="Open menu">
        <span class="bf-hamburger__bar"></span>
        <span class="bf-hamburger__bar"></span>
        <span class="bf-hamburger__bar"></span>
      </button>
    {%- endunless -%}

    <a href="{{ routes.root_url }}" aria-label="BULLRUSH home">
      {% render 'logo-wordmark', background: 'dark', layout: 'horizontal' %}
    </a>

    {%- unless minimal -%}
      <nav aria-label="Main">
        <ul class="bf-header__nav">
          {%- for link in section.settings.main_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endunless -%}

    <div class="bf-header__actions">
      <a href="{{ routes.account_url }}" aria-label="Account" class="bf-header__icon-link bf-header__account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="20" height="20"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" stroke-linecap="round"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items" class="bf-header__icon-link bf-header__cart-icon" data-bf-cart-drawer-open>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="20" height="20"><path d="M4 7h16l-1.5 12.5a2 2 0 0 1-2 1.5H7.5a2 2 0 0 1-2-1.5L4 7z"/><path d="M8 7a4 4 0 0 1 8 0" stroke-linecap="round"/></svg>
        <span class="bf-header__cart-count" data-bf-cart-count>{{ cart.item_count }}</span>
      </a>
      <a href="{{ section.settings.shop_now_url | default: routes.all_products_collection_url }}" class="bf-btn bf-btn--primary bf-header__shop-now">{{ section.settings.shop_now_label }}</a>
    </div>
  </div>
</header>

{%- unless minimal -%}
  <div class="bf-nav-drawer__backdrop" data-bf-nav-drawer-backdrop></div>
  <nav id="bf-nav-drawer" class="bf-nav-drawer" data-bf-nav-drawer aria-label="Mobile">
    <button type="button" class="bf-nav-drawer__close" data-bf-nav-drawer-close aria-label="Close menu">✕</button>
    {%- for link in section.settings.main_menu.links -%}
      {%- if link.links.size > 0 -%}
        <div class="bf-nav-drawer__group">
          <button type="button" class="bf-nav-drawer__group-trigger" data-bf-drawer-group-trigger aria-expanded="false">
            {{ link.title }}
            <span class="bf-nav-drawer__chevron">▾</span>
          </button>
          <ul class="bf-nav-drawer__sublist" data-open="false">
            {%- for sublink in link.links -%}
              <li><a href="{{ sublink.url }}">{{ sublink.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- else -%}
        <a href="{{ link.url }}" class="bf-nav-drawer__link">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
{%- endunless -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main menu",
      "info": "Add sub-links to a menu item in Navigation settings to turn it into a collapsible group in the mobile drawer.",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "minimal_nav",
      "label": "Minimal header (no nav links) — use on DR landing / offer pages",
      "default": false
    },
    { "type": "text", "id": "shop_now_label", "label": "Shop Now button label", "default": "Shop Now" },
    { "type": "url", "id": "shop_now_url", "label": "Shop Now button link", "info": "Defaults to the main products collection if left blank" }
  ]
}
{% endschema %}
