<div class="bf-sticky-cta" data-bf-sticky-cta>
  <div>
    <span class="bf-sticky-cta__price" data-bf-sticky-price>{{ section.settings.fallback_price }}</span>
    <span class="bf-sticky-cta__price-sub" data-bf-sticky-price-sub>{{ section.settings.fallback_subtext }}</span>
  </div>
  <button type="button" class="bf-btn bf-btn--primary" data-bf-sticky-cta-jump="[data-bf-purchase]">
    {{ section.settings.button_label }}
  </button>
</div>

{% schema %}
{
  "name": "Sticky mobile CTA",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose Your Supply" },
    { "type": "text", "id": "fallback_price", "label": "Fallback price text", "default": "From $39.99/bottle" },
    { "type": "text", "id": "fallback_subtext", "label": "Fallback subtext", "default": "Subscribe & Save" }
  ]
}
{% endschema %}
