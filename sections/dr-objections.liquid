{% comment %} Objections answered in sequence, ending on a CTA. {% endcomment %}
<section class="bf-section bf-bg-charcoal">
  <div class="bf-container bf-max-640">
    <span class="bf-eyebrow">Before You Decide</span>
    <h2>{{ section.settings.heading }}</h2>
    <div>
      {%- for block in section.blocks -%}
        <div class="bf-objection">
          <div class="bf-objection__num">{{ forloop.index }}</div>
          <div>
            <h3 style="margin-bottom:6px;">{{ block.settings.objection }}</h3>
            <p class="bf-muted" style="margin:0;">{{ block.settings.answer }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="bf-text-center bf-mt-32">
      <a href="#bf-purchase" class="bf-btn bf-btn--primary">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DR Objections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions before you order" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Choose Your Supply" }
  ],
  "blocks": [
    {
      "type": "objection",
      "name": "Objection",
      "settings": [
        { "type": "text", "id": "objection", "label": "Objection / question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "objection", "settings": { "objection": "Is this safe?", "answer": "[PLACEHOLDER — insert safety/interaction guidance reviewed by a qualified professional before publishing]." } },
      { "type": "objection", "settings": { "objection": "How is this different from other gummies?", "answer": "Transparent formula, no proprietary blends, made to a premium standard — not a mass-market energy gummy." } },
      { "type": "objection", "settings": { "objection": "What if it doesn't work for me?", "answer": "Covered by our 90-day guarantee — see /pages/guarantee for full terms." } },
      { "type": "objection", "settings": { "objection": "How does the subscription actually work?", "answer": "You see the recurring price and delivery frequency before you subscribe. Skip, pause, or cancel anytime from your account before the next charge." } }
    ]
  },
  "presets": [{ "name": "DR Objections" }]
}
{% endschema %}
