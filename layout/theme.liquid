<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- comment -%} Favicon: derived from the symbol-only mark (merchant upload if set, else the bundled temporary BULLRUSH symbol). {%- endcomment -%}
  {%- if settings.logo_symbol_only_light_bg != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.logo_symbol_only_light_bg | image_url: width: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'bullrush-symbol-light.svg' | asset_url }}">
  {%- endif -%}

  {{ content_for_header }}

  <style>
    :root{
      --bf-black: {{ settings.color_primary_black }};
      --bf-charcoal: {{ settings.color_deep_charcoal }};
      --bf-dark-surface: {{ settings.color_dark_surface }};
      --bf-accent: {{ settings.color_acid_green }};
      --bf-accent-deep: {{ settings.color_acid_green_deep }};
      --bf-lime: {{ settings.color_electric_lime }};
      --bf-olive: {{ settings.color_dark_olive }};
      --bf-accent-on-light: {{ settings.color_dark_olive }}; /* dark olive stands in for acid green wherever accent text sits on the off-white/light-gray reset sections -- raw acid green is ~1.2:1 on off-white and fails contrast outright; dark olive on off-white clears WCAG AAA */
      --bf-white: {{ settings.color_white }};
      --bf-light-gray: {{ settings.color_light_gray }};
      --bf-muted-gray: {{ settings.color_muted_gray }};
      --bf-font-display: {{ settings.font_display.family }}, {{ settings.font_display.fallback_families }};
      --bf-font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
    }
    {{ settings.font_display | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
  </style>

  {{ 'bullrush.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-{{ request.page_type }}">
  <a class="bf-skip-link" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% if settings.enable_sticky_cta %}
    {% section 'sticky-mobile-cta' %}
  {% endif %}

  {%- comment -%} Cart drawer chrome: not header/footer content, so it's included directly per Dawn's own convention for cart-notification/cart-drawer. Re-rendered live via the Section Rendering API. {%- endcomment -%}
  {% if settings.enable_cart_drawer %}
    {% section 'cart-drawer' %}
  {% endif %}

  <script src="{{ 'bullrush.js' | asset_url }}" defer></script>
</body>
</html>
